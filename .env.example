# Public URL of the SRVN backend (no trailing slash)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Public sharing website origin. Match backend SHARE_BASE_URL.
# Production: SHARE_APP_ENV=production and an explicit HTTPS website origin.
# Development must use its own host and targets srvn-dev / com.srvnapp.srvn.dev.
SHARE_APP_ENV=development
SHARE_BASE_URL=http://localhost:3000

# Leave store URLs empty while SRVN is not publicly available.
# Set each verified listing independently when that platform is released.
SRVN_IOS_STORE_URL=
SRVN_ANDROID_STORE_URL=

# Verified application-identifier prefix from the signed iOS app (usually Team ID).
# Empty means no iOS app is authorized by the association document yet.
APPLE_APP_ID_PREFIX=

# Comma-separated SHA-256 signing certificate fingerprints (32 colon-separated bytes).
# Use Play App Signing's certificate for Play releases, not the upload key or Maps SHA-1.
# Empty means no Android app is authorized by the association document yet.
ANDROID_SHA256_CERT_FINGERPRINTS=
